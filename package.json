{
  "name": "zvireci-sachy",
  "description": "Zvířecí šachy (nejen) pro děti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-engine.mjs",
    "build:pages": "tsc --noEmit && vite build --base /",
    "build:dev-site": "tsc --noEmit && vite build --base / --mode devsite",
    "publish:dev-site": "npm run build:dev-site && node scripts/publish-pages.mjs %USERPROFILE%/zvireci-sachy-dev && node scripts/push-pages.mjs %USERPROFILE%/zvireci-sachy-dev \"dev site\""
  },
  "dependencies": {
    "@lichess-org/chessground": "10.1.1",
    "chess.js": "1.4.0",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
